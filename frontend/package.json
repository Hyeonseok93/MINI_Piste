{
  "name": "piste-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test",
    "preview": "vite preview",
    "knip": "npx -y knip@5 --no-progress",
    "gen:api": "uv --directory ../backend run python -m app.export_openapi ../frontend/openapi.json && npx -y openapi-typescript@7 openapi.json -o src/api/schema.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
